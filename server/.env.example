# Claude API key. Without it every AI route returns a clearly-labelled mock
# (source: "mock") rather than failing — the demo still runs, but the document
# scanner is not really reading the card.
ANTHROPIC_API_KEY=sk-ant-...your-key-here

# Optional model override. Defaults to claude-sonnet-5.
# CLAUDE_MODEL=claude-sonnet-5

# NOT 5000: macOS ControlCenter (AirPlay Receiver) occupies 5000 and answers
# 403, which makes a dead API look alive. Keep this in sync with the Vite proxy
# target in client/vite.config.js.
PORT=5050

# Text-to-speech. Optional; the client falls back to the browser's own
# SpeechSynthesis when this is unset.
# ELEVENLABS_API_KEY=
